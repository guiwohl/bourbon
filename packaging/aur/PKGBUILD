pkgname=bourbon
pkgver=0.1.0
pkgrel=1
pkgdesc='Markdown notes app'
arch=('x86_64')
url='https://github.com/guiwohl/bourbon'
license=('GPL-3.0-only')
depends=('fontconfig' 'freetype2' 'wayland' 'libxkbcommon' 'libxcb' 'git')
makedepends=('rust' 'cargo' 'clang' 'cmake')
_tarball_sha256='REPLACE_AT_RELEASE'
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("$_tarball_sha256")

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/bourbon-app "$pkgdir/usr/bin/bourbon-app"
  install -Dm755 target/release/bourbon "$pkgdir/usr/bin/bourbon"
  install -Dm644 packaging/bourbon.desktop "$pkgdir/usr/share/applications/bourbon.desktop"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/bourbon.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/bourbon.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
